# ─── LLM Provider ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
VULNGUARD_LLM_PROVIDER=openai
VULNGUARD_LLM_MODEL=gpt-4o
VULNGUARD_LLM_MAX_TOKENS=4096
VULNGUARD_HIGH_RISK_PROVIDER=openai
VULNGUARD_HIGH_RISK_MODEL=gpt-4o
VULNGUARD_MEDIUM_RISK_PROVIDER=openai
VULNGUARD_MEDIUM_RISK_MODEL=gpt-4o-mini

# ─── ML Triage ─────────────────────────────────────────────────
VULNGUARD_RISK_THRESHOLD=65
VULNGUARD_PARSE_TIMEOUT=5
VULNGUARD_USE_SMOTE=false

# ─── Agent Pipeline ───────────────────────────────────────────
VULNGUARD_MAX_RETRIES=3
VULNGUARD_CONTEXT_TOKEN_BUDGET=6000
VULNGUARD_RESCAN_PATCH=true

# ─── Docker Sandbox ───────────────────────────────────────────
VULNGUARD_DOCKER_MEMORY=512m
VULNGUARD_DOCKER_CPUS=1
VULNGUARD_DOCKER_TIMEOUT=60
VULNGUARD_SANDBOX_IMAGE=vulnguard-sandbox:latest
VULNGUARD_ENV_FILE=

# ─── General ──────────────────────────────────────────────────
VULNGUARD_VERBOSE=false
