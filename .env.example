# ─── LLM Provider ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
VULNGUARD_LLM_PROVIDER=gemini
VULNGUARD_LLM_MODEL=gemini-3.8-flash
VULNGUARD_LLM_MAX_TOKENS=4096
VULNGUARD_HIGH_RISK_PROVIDER=gemini
VULNGUARD_HIGH_RISK_MODEL=gemini-3.1-pro-preview
VULNGUARD_MEDIUM_RISK_PROVIDER=gemini
# Stable profile: use Pro for agent JSON. Flash occasionally returns thinking without content.
VULNGUARD_MEDIUM_RISK_MODEL=gemini-3.1-pro-preview

# ─── ML Triage ─────────────────────────────────────────────────
VULNGUARD_RISK_THRESHOLD=65
VULNGUARD_PARSE_TIMEOUT=5
VULNGUARD_USE_SMOTE=false

# ─── Agent Pipeline ───────────────────────────────────────────
VULNGUARD_MAX_RETRIES=3
VULNGUARD_CONTEXT_TOKEN_BUDGET=6000
VULNGUARD_RESCAN_PATCH=true

# ─── Docker Sandbox ───────────────────────────────────────────
VULNGUARD_DOCKER_MEMORY=512m
VULNGUARD_DOCKER_CPUS=1
VULNGUARD_DOCKER_TIMEOUT=60
VULNGUARD_SANDBOX_IMAGE=vulnguard-sandbox:latest
VULNGUARD_ENV_FILE=

# ─── General ──────────────────────────────────────────────────
VULNGUARD_VERBOSE=false
